{
    "parsnips_protocol_version": "3.0.0",
    "strict": true,
    "log": {
        "quiet": false,
        "file_path": null
    },
    "search": {
        "searcher_python_class": "parsnips.searchers.parsnips_searcher.ParsnipsSearcher",
        "use_unicode": false,
        "use_regex": false,
        "swh": {
            "repo_url": null,
            "commit": null,
            "release_name": null,
            "ref_name": null,
            "visit": null,
            "repo_root": null
        },
        "include_patterns": {
            "regex": [],
            "glob": [
                {
                    "pattern": "*.py"
                }
            ]
        },
        "exclude_patterns": {
            "regex": [],
            "glob": []
        }
    },
    "extract": {
        "extractions": [
            {
                "language": "python",
                "extractor_python_class": "parsnips.extractors.tree_sitter_extractor.TreeSitterExtractor",
                "extractor_script": {
                    "name": "parsnips",
                    "version": "3.0.0",
                    "command": [
                        "parsnips"
                    ],
                    "settings": {}
                },
                "include_patterns": {
                    "regex": [],
                    "glob": [
                        {
                            "pattern": "*.py"
                        }
                    ]
                },
                "exclude_patterns": {
                    "regex": [],
                    "glob": []
                }
            }
        ]
    }
}